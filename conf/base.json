      {
        "type": "inline",
        "tag": "my-direct",
        "rules": [
          {
            "domain_suffix": [
              "lan",
              "googleads.g.doubleclick.net",
              "zoom.us"
            ]
          }
        ]
      },
      {
        "type": "inline",
        "tag": "my-proxy",
        "rules": [
          {
            "domain_suffix": [
              "112114.xyz",
              "catbox.moe",
              "qiyiguo.uk",
              "community.oneplus.com",
              "xiaomi.eu",
              "xn--4gq62f52gdss.ink",
              "xn--7kq24s4ynvb.site"
            ]
          }
        ]
      },
      {
        "type": "inline",
        "tag": "my-block",
        "rules": [
          {
            "domain_suffix": [
              "applovin.com",
              "applvn.com",
              "in.appcenter.ms"
            ]
          }
        ]
      }
    ],
    "final": "DIRECT",
    "default_mark": 7894,
    "default_domain_resolver": "dns_direct",
    "default_http_client": "http_proxy"
  },
  "http_clients": [
    {
      "tag": "http_proxy",
      "detour": "🚀 节点选择"
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/tmp/cache.db",
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9999",
      "external_ui": "ui"
    }
  }
